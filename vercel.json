{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*\\.js)",
      "headers": [{ "key": "Content-Type", "value": "application/javascript; charset=utf-8" }]
    },
    {
      "source": "/library/(.*)\\.flac",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ]
}
